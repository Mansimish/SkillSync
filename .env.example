# Docker Compose only. Native setup uses backend/.env and frontend/.env.
# Replace both values locally before starting. Never commit the resulting .env.
POSTGRES_PASSWORD=replace-with-a-generated-database-password
JWT_SECRET=replace-with-a-long-random-secret
# Backend-only Google AI Studio key used by the Compose app.
GEMINI_API_KEY=replace-with-your-gemini-api-key
