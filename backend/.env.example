APP_NAME=SkillSync
APP_ENV=development
LOG_LEVEL=INFO
# Optional: absolute path to a built frontend. Docker sets this automatically.
# FRONTEND_DIST_DIR=/app/frontend-dist
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/skillsync
FRONTEND_ORIGIN=http://localhost:5173
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_COOKIE_NAME=skillsync_session
# Must be true when APP_ENV=production and the frontend is served over HTTPS.
AUTH_COOKIE_SECURE=false
# Per-process, per-client limit. Use a shared gateway limit for multi-worker deployments.
AUTH_REQUESTS_PER_MINUTE=20
MAX_API_BODY_KB=128
RESUME_STORAGE_DIR=storage/resumes
MAX_RESUME_SIZE_MB=5
MAX_RESUME_PAGES=50
# Backend-only key from Google AI Studio. Never use this in a VITE_* variable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AI_TIMEOUT_SECONDS=120
AI_MAX_OUTPUT_TOKENS=1536
RESUME_ANALYSIS_MAX_CHARACTERS=40000
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=6
RAG_MAX_CONTEXT_CHARACTERS=8000
RAG_HISTORY_LIMIT=8
RAG_EMBEDDING_DIMENSIONS=768
RAG_MIN_SIMILARITY=0.2
# Use pgvector only after running deploy/init-vector.sql on PostgreSQL.
RAG_VECTOR_BACKEND=python
INTERVIEW_QUESTION_LIMIT=5
